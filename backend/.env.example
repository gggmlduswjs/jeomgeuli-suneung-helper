# OpenAI API 키 (LLM 기능 사용 시 필수)
OPENAI_API_KEY=your-openai-api-key-here

# 데이터베이스 URL (선택, 기본값: SQLite)
# Render나 다른 클라우드 서비스에서 PostgreSQL 사용 시 자동으로 설정됨
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS 허용 도메인 (선택, 기본값: localhost)
# CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# PDF 처리 도구 경로 (선택, 자동 감지됨)
# Windows 예시:
# POPPLER_PATH=C:\poppler\Library\bin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Linux/macOS 예시:
# POPPLER_PATH=/usr/bin
# TESSERACT_CMD=/usr/bin/tesseract

# MathPix API (수식 OCR 사용 시 선택)
# MATHPIX_APP_ID=your-mathpix-app-id
# MATHPIX_APP_KEY=your-mathpix-app-key

# Roboflow API (YOLO 모델 사용 시 선택)
# ROBOFLOW_API_KEY=your-roboflow-api-key
# ROBOFLOW_WORKSPACE_ID=your-workspace-id
# ROBOFLOW_PROJECT_ID=your-project-id
